#!/bin/sh
set -eu

find_p40() {
    /usr/bin/nvidia-smi --query-gpu=pci.bus_id,name --format=csv,noheader 2>/dev/null |
        awk -F ',' '/Tesla P40/ {
            gsub(/^[ \t]+|[ \t]+$/, "", $1)
            print $1
            exit
        }'
}

DEVICE=
for attempt in $(seq 1 60); do
    DEVICE=$(find_p40)
    if [ -n "$DEVICE" ]; then
        break
    fi
    sleep 1
done

test -n "$DEVICE"
/usr/bin/nvidia-smi -i "$DEVICE" -ac 3615,1911
actual=$(/usr/bin/nvidia-smi -i "$DEVICE" --query-gpu=clocks.applications.graphics --format=csv,noheader,nounits)
test "$actual" = 1911
